{
  "name": "dsh-desktop",
  "productName": "DeepSeek Harness",
  "version": "0.1.1",
  "description": "DeepSeek Harness 桌面端外壳：原生窗口内运行完整的 DSH Web GUI，功能与网页端完全一致。",
  "author": "QMNQ924",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "pack": "electron-builder --win --publish never"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.dsh.desktop",
    "productName": "DeepSeek Harness",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "window-controls.js",
      "loading.html",
      "dsh.ico"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "dsh.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeepSeek Harness",
      "artifactName": "DeepSeek-Harness-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "DeepSeekHarness-Portable-${version}.exe"
    }
  }
}
